# Empêcher l'exécution de scripts dans le dossier des photos de profil
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|phar|cgi|pl|sh|exe)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
